# --- Firebase web app config (Project settings -> General -> Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000:web:abc123

# --- Firebase Admin (Project settings -> Service accounts -> Generate key) ---
# Paste the downloaded JSON as ONE line, or base64-encode the file and paste that.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Daily email digest (tier one) ---
# Resend API key (resend.com; free tier is fine) and a verified sender.
RESEND_API_KEY=
DIGEST_FROM="DuoCount <digest@yourdomain.com>"
# Shared secret for the Vercel cron route (/api/cron/digest). Vercel sends it
# automatically as `Authorization: Bearer ...` when this env var is set.
CRON_SECRET=
# Optional absolute URL used for the "Review in DuoCount" link in the digest.
APP_URL=

# --- Developer / platform-admin console (/dev) ---
# The developer isn't a store owner, so they sign in with a DEDICATED login at
# /dev (or the "Developer" link on the sign-in screen) — a separate email +
# password held here as server secrets. Set BOTH to turn the developer login on;
# leave either blank and the login is off. Use a strong, unique password.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
#
# Legacy/optional bootstrap: a comma-separated Firebase Auth UID allowlist that
# also unlocks the console for a STORE account whose uid (`<vendorId>_<userId>`)
# is listed. The /dev denied screen shows a signed-in owner their own uid to
# paste here. Prefer DEV_ADMIN_* above; this stays for backward compatibility.
PLATFORM_ADMIN_UIDS=

# --- Optional: AI digest narrative (ai-features-spec.md, off by default) ---
# Anthropic API key. When set AND a vendor has opted in (vendor.digest.narrative
# === true), the digest email gains a short AI-written summary + "what to watch
# tomorrow" list, generated from the same aggregates the digest already computes
# (names pseudonymized before egress). Leave blank to keep the feature inert —
# the digest sends exactly as it does without it.
ANTHROPIC_API_KEY=
