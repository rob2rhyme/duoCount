rules_version = '2';

// ---------------------------------------------------------------------------
// Firestore security rules
//
//   phoneAuth  – holds the store phone number the login screen sends the OTP
//                to. Readable by anyone (needed BEFORE sign-in); never writable
//                from the client. Manage it from the Firebase console.
//   products   – inventory items. Read/write only for signed-in users.
//   categories – product groupings.  Read/write only for signed-in users.
//
// Tighten these further (per-user ownership, role claims, etc.) as your
// deployment requires — see documentation/index.html → "Security rules".
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    match /phoneAuth/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
