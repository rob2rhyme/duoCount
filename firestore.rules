rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All auth goes through the app's API routes, which verify the store
    // code + hashed PIN and mint a custom token whose claims carry
    // vendorId / role / locationId. These rules enforce tenant isolation:
    // a signed-in user can only ever touch documents under their own vendor.

    match /vendors/{vendorId} {

      function member() {
        return request.auth != null && request.auth.token.vendorId == vendorId;
      }
      function mgr() {
        return member() && request.auth.token.role in ['manager', 'owner'];
      }
      function owner() {
        return member() && request.auth.token.role == 'owner';
      }
      function sharedAcrossLocations() {
        return get(/databases/$(database)/documents/vendors/$(vendorId)).data.sharingMode == 'all-locations';
      }

      // Role and active-state live in the token claims, which freeze at sign-in,
      // so a deactivated or demoted user keeps their access until the token is
      // re-minted. To enforce a mid-session deactivation WITHOUT waiting for the
      // token to expire, every write consults the LIVE user doc: a user whose
      // doc is active:false can no longer write, even holding a valid token.
      // Reads stay on the token (a get() on every listener would be costly, and
      // the client SessionProvider force-signs-out a deactivated/demoted user,
      // stopping their reads too). A missing 'active' defaults to true, matching
      // the app's optional-field convention. Role demotion is caught by the same
      // client sign-out; the rules ban here is specifically the write kill-switch.
      function liveActive() {
        return get(/databases/$(database)/documents/vendors/$(vendorId)/users/$(request.auth.token.userId))
                 .data.get('active', true) == true;
      }

      // Vendor doc: members read; only the owner may edit branding + settings.
      // (digest.lastSentDate is written by the Admin SDK cron, which bypasses rules.)
      allow read: if member();
      allow update: if owner() && liveActive()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'logoUrl', 'sharingMode', 'invVarianceThreshold',
                       'blindCounts', 'varianceThreshold', 'digest', 'patternRules',
                       'fiscalStartMonth']);
      allow create, delete: if false; // vendors are created by the signup API

      match /locations/{locationId} {
        allow read: if member();
        allow create, update: if mgr() && liveActive();
        allow delete: if false; // disable instead, so history keeps its labels
      }

      match /drawers/{drawerId} {
        allow read: if member();
        allow create, update: if mgr() && liveActive();
        allow delete: if false;
      }

      // Tracked inventory items — same lifecycle as drawers (soft-disable only).
      match /items/{itemId} {
        allow read: if member();
        allow create, update: if mgr() && liveActive();
        allow delete: if false;
      }

      // Scratch-off packs: received -> active -> settled | returned,
      // forward-only and never deleted — enforced here, not just in the UI.
      match /packs/{packId} {
        allow read: if member();
        allow create: if mgr() && liveActive() && request.resource.data.status in ['received', 'active'];
        allow update: if mgr() && liveActive()
          && request.resource.data.status in ['received', 'active', 'settled', 'returned']
          && (
            // forward-only transitions
            (resource.data.status == 'received' && request.resource.data.status == 'active')
            || (resource.data.status == 'active'
                && request.resource.data.status in ['settled', 'returned'])
            // metadata edit (status unchanged) — but a settled/returned pack is
            // terminal: its settle snapshot (soldAtSettle/shortAtSettle/price…)
            // is frozen HERE, in rules, not just by the absence of a UI control.
            || (resource.data.status == request.resource.data.status
                && (!(resource.data.status in ['settled', 'returned'])
                    || request.resource.data.diff(resource.data).affectedKeys().size() == 0))
          );
        allow delete: if false;
      }

      match /users/{userId} {
        allow read: if member();       // names/roles power the admin panel
        allow write: if false;         // created/updated only via the staff API
        match /private/{docId} {
          allow read, write: if false; // PIN hashes are never client-readable
        }
      }

      match /entries/{entryId} {
        // Managers/owners see everything. Employees see everything when the
        // vendor shares across locations, otherwise only their own location.
        allow read: if member() && (
          mgr()
          || sharedAcrossLocations()
          || (request.auth.token.locationId != null
              && resource.data.locationId == request.auth.token.locationId)
        );

        // Entries are signed: the author's name/id must match the token,
        // employees can only log for their assigned location, and tier-one
        // status fields must start clean (no pre-resolved / pre-disputed rows).
        allow create: if member() && liveActive()
          && request.resource.data.by == request.auth.token.name
          && request.resource.data.byId == request.auth.token.userId
          && request.resource.data.byRole == request.auth.token.role
          && request.resource.data.kind in ['cash', 'scratch', 'inventory']
          && request.resource.data.verifiedBy == null
          && (mgr() || request.resource.data.locationId == request.auth.token.locationId)
          && request.resource.data.get('disputeStatus', 'none') == 'none'
          && request.resource.data.get('varianceStatus', 'none') in ['none', 'open']
          && request.resource.data.get('causeCode', null) == null
          && varianceConsistent()
          && flagConsistent();

        // Cash/inventory entries carry counted/expected/diff; the stored diff
        // must equal counted - expected (±0.01 to absorb float cents) so a
        // non-manager can't sign a clean-looking count that hides a real short
        // from the owner digest and the theft-pattern detectors, both of which
        // trust the stored diff. Scratch entries have no diff and are exempt.
        function varianceConsistent() {
          return !(request.resource.data.kind in ['cash', 'inventory'])
            || (request.resource.data.diff is number
                && request.resource.data.counted is number
                && request.resource.data.expected is number
                && request.resource.data.diff
                     >= request.resource.data.counted - request.resource.data.expected - 0.01
                && request.resource.data.diff
                     <= request.resource.data.counted - request.resource.data.expected + 0.01);
        }

        // A cash count at or beyond the store's variance threshold must be signed
        // as an OPEN variance — a client can't record a real short/over as
        // 'none' and hide it from the review queue, the owner dashboard/digest,
        // and the theft-pattern detectors. Cash always auto-flags (default $5
        // threshold); inventory flags only when the owner opts in with a positive
        // unit threshold (scratch has no diff). Both fail OPEN when the threshold
        // is unset/misconfigured so a bad setting can never reject a legitimate
        // count. Mirrors the forms' `abs(diff) >= threshold`.
        function cashVarianceThreshold() {
          return get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('varianceThreshold', 5);
        }
        function invVarianceThreshold() {
          return get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('invVarianceThreshold', null);
        }
        function flagConsistent() {
          return flagOk('cash', cashVarianceThreshold()) && flagOk('inventory', invVarianceThreshold());
        }
        // For the named kind, an at/over-threshold |diff| must be signed as an
        // open variance. Fail-open when this entry is another kind, the threshold
        // isn't a positive number, or diff isn't numeric.
        function flagOk(kind, threshold) {
          return request.resource.data.kind != kind
            || !(threshold is number)
            || !(threshold > 0)
            || !(request.resource.data.diff is number)
            || math.abs(request.resource.data.diff) < threshold
            || request.resource.data.get('varianceStatus', 'none') == 'open';
        }

        // Manager verification — never self-verified. (Existing rule, verbatim.)
        function verifyOnly() {
          return mgr()
            && resource.data.byId != request.auth.token.userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['verifiedBy', 'verifiedAt'])
            && request.resource.data.verifiedBy == request.auth.token.name;
        }

        // Managers work a flagged entry: open -> under-review -> resolved.
        // Resolving requires a cause code and stamps the resolver. The entry must
        // already BE in the queue (open/under-review) — a manager can't fabricate a
        // resolution on a clean 'none' count, or re-open a 'resolved' one (L9).
        // Separation of duties: a manager can't investigate/resolve their OWN
        // flagged count, mirroring verifyOnly() — clearing your own short needs an
        // independent reviewer (a single-manager store leaves it open, by design).
        function investigate() {
          return mgr()
            && resource.data.byId != request.auth.token.userId
            && resource.data.get('varianceStatus', 'none') in ['open', 'under-review']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['varianceStatus', 'causeCode', 'causeNote', 'resolvedBy', 'resolvedAt'])
            && request.resource.data.varianceStatus in ['open', 'under-review', 'resolved']
            && (request.resource.data.varianceStatus != 'resolved'
                || (request.resource.data.causeCode != null
                    && request.resource.data.resolvedBy == request.auth.token.name));
        }

        // Only the entry's author may open a dispute, exactly once.
        function disputeOpen() {
          return member()
            && resource.data.byId == request.auth.token.userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputeStatus'])
            && resource.data.get('disputeStatus', 'none') == 'none'
            && request.resource.data.disputeStatus == 'open';
        }

        // Managers advance/close disputes — but only ones an author actually
        // opened. A manager can't resolve a dispute that was never raised (L9).
        function disputeManage() {
          return mgr()
            && resource.data.get('disputeStatus', 'none') in ['open', 'under-review']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputeStatus'])
            && request.resource.data.disputeStatus in ['under-review', 'resolved'];
        }

        // The denormalized comment counter may only move +1, and only in lockstep
        // with an actual comment write in the SAME commit (M4). lastCommentId names
        // that comment; the rule requires it to be a doc that did NOT exist before
        // and DOES exist after this commit — i.e. genuinely created here. Because a
        // batch shares one request.auth, that comment was created by this user and
        // already passed the comments create rule. A standalone counter bump with
        // no comment (or one pointed at a pre-existing comment) is refused, so the
        // count can't be inflated past the real thread length.
        function commentBump() {
          return member()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['commentCount', 'lastCommentAt', 'lastCommentId'])
            && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            && request.resource.data.lastCommentId is string
            && !exists(/databases/$(database)/documents/vendors/$(vendorId)/entries/$(entryId)/comments/$(request.resource.data.lastCommentId))
            && existsAfter(/databases/$(database)/documents/vendors/$(vendorId)/entries/$(entryId)/comments/$(request.resource.data.lastCommentId))
            && (mgr() || sharedAcrossLocations()
                || (request.auth.token.locationId != null
                    && resource.data.locationId == request.auth.token.locationId));
        }

        allow update: if liveActive()
          && (verifyOnly() || investigate() || disputeOpen() || disputeManage() || commentBump());

        allow delete: if false; // append-only, for trust

        // Append-only dispute/comment thread; visibility inherits the entry's.
        match /comments/{commentId} {
          function parentEntry() {
            return get(/databases/$(database)/documents/vendors/$(vendorId)/entries/$(entryId)).data;
          }
          allow read: if member() && (
            mgr() || sharedAcrossLocations()
            || (request.auth.token.locationId != null
                && parentEntry().locationId == request.auth.token.locationId));
          allow create: if member() && liveActive()
            && request.resource.data.byId == request.auth.token.userId
            && request.resource.data.by == request.auth.token.name
            && request.resource.data.byRole == request.auth.token.role
            && request.resource.data.kind in ['comment', 'status']
            // Only managers may post an authoritative 'status' line (the
            // resolved-by / dispute-resolved system notes); staff post 'comment'.
            && (request.resource.data.kind == 'comment' || mgr())
            // Writing into a thread requires the same location visibility as
            // reading it — employees can't comment on entries they can't see.
            && (mgr() || sharedAcrossLocations()
                || (request.auth.token.locationId != null
                    && parentEntry().locationId == request.auth.token.locationId))
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
          allow update, delete: if false;
        }
      }

      // Incident write-ups are personnel records, so visibility is narrower
      // than entries: managers see all, the subject sees their own, coworkers
      // never see each other's. Text is immutable; the only lifecycle moves
      // are the subject's one-time acknowledgment and a manager close.
      match /incidents/{incidentId} {
        allow read: if mgr()
          || (member() && resource.data.subjectId == request.auth.token.userId);

        allow create: if mgr() && liveActive()
          && request.resource.data.by == request.auth.token.name
          && request.resource.data.byId == request.auth.token.userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.severity in ['note', 'warning', 'serious']
          && request.resource.data.status == 'open'
          && request.resource.data.ackAt == null
          && request.resource.data.ackNote == null
          && request.resource.data.closedBy == null
          && request.resource.data.links is list
          && request.resource.data.links.size() <= 5;

        // "I have seen this" — subject only, once, while open; the optional
        // note is the employee's side, permanent like everything else.
        function ackOwn() {
          return member()
            && resource.data.subjectId == request.auth.token.userId
            && resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'ackAt', 'ackNote'])
            && request.resource.data.status == 'acknowledged'
            && (request.resource.data.ackNote == null
                || request.resource.data.ackNote.size() <= 1000);
        }

        // Closing an unacknowledged incident is allowed (the subject may
        // refuse, or may no longer work there).
        function closeIncident() {
          return mgr()
            && resource.data.status in ['open', 'acknowledged']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'closedBy', 'closedAt'])
            && request.resource.data.status == 'closed'
            && request.resource.data.closedBy == request.auth.token.name;
        }

        allow update: if liveActive() && (ackOwn() || closeIncident());
        allow delete: if false;
      }

      // Time clock — append-only in/out punches, signed by the employee.
      // Managers/owners see the whole store; an employee sees only their own.
      // Immutable: a mistaken punch is corrected by punching again, never by
      // editing the record (same trust model as entries and incidents).
      match /timeclock/{punchId} {
        allow read: if mgr()
          || (member() && resource.data.userId == request.auth.token.userId);

        allow create: if member() && liveActive()
          && request.resource.data.userId == request.auth.token.userId
          && request.resource.data.userName == request.auth.token.name
          && request.resource.data.type in ['in', 'out']
          // The punch time is the hours-bearing field, so it must be the server's
          // clock, not a client-chosen value — otherwise an employee could
          // back/forward-date a punch to inflate paid hours. (`day` stays the
          // client's business-day label for reconciliation.)
          && request.resource.data.ts == request.time
          && (mgr() || request.resource.data.locationId == request.auth.token.locationId);

        allow update, delete: if false;
      }

      // Shift schedule — a manager-managed roster (a plan, not an audit trail,
      // so unlike punches it is editable and deletable). Managers see and manage
      // the whole roster; an employee sees their own shifts, plus any shift that
      // is up for a swap (offered/claimed) so they can pick it up.
      match /schedule/{shiftId} {
        allow read: if mgr()
          || (member() && resource.data.userId == request.auth.token.userId)
          || (member() && resource.data.get('swapStatus', 'none') != 'none')
          || (member() && resource.data.get('open', false) == true);

        // A manager creates either an assigned shift (userId is a staff id) or an
        // OPEN shift (userId null, open:true) for anyone to pick up.
        allow create: if mgr() && liveActive()
          && request.resource.data.by == request.auth.token.name
          && request.resource.data.byId == request.auth.token.userId
          && request.resource.data.date is string
          && request.resource.data.start is string
          && request.resource.data.end is string
          && (
            (request.resource.data.userId is string && request.resource.data.userName is string)
            || (request.resource.data.userId == null && request.resource.data.get('open', false) == true)
          );

        allow delete: if mgr() && liveActive();

        function swapOffer() {
          return member()
            && resource.data.userId == request.auth.token.userId
            && resource.data.get('swapStatus', 'none') == 'none'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['swapStatus'])
            && request.resource.data.swapStatus == 'offered';
        }
        function swapCancel() {
          return member()
            && resource.data.userId == request.auth.token.userId
            && resource.data.get('swapStatus', 'none') == 'offered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['swapStatus'])
            && request.resource.data.swapStatus == 'none';
        }
        function swapClaim() {
          return member()
            && resource.data.userId != request.auth.token.userId
            && resource.data.get('swapStatus', 'none') == 'offered'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['swapStatus', 'claimedById', 'claimedByName'])
            && request.resource.data.swapStatus == 'claimed'
            && request.resource.data.claimedById == request.auth.token.userId
            && request.resource.data.claimedByName == request.auth.token.name;
        }
        function swapWithdraw() {
          return member()
            && resource.data.get('swapStatus', 'none') == 'claimed'
            && resource.data.claimedById == request.auth.token.userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['swapStatus', 'claimedById', 'claimedByName'])
            && request.resource.data.swapStatus == 'offered'
            && request.resource.data.claimedById == null
            && request.resource.data.claimedByName == null;
        }
        // An employee grabs an OPEN shift, assigning it to themselves. Direct —
        // no approval — since the manager posted it wanting it covered.
        function claimOpen() {
          return member()
            && resource.data.get('open', false) == true
            && resource.data.userId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'userName', 'open'])
            && request.resource.data.userId == request.auth.token.userId
            && request.resource.data.userName == request.auth.token.name
            && request.resource.data.open == false;
        }

        // Managers may edit anything (incl. approve/reject: an approve reassigns
        // userId to the claimer). Employees may only drive the swap state machine
        // on their own / an offered shift, or grab an open shift — see lib/swaps.js.
        allow update: if liveActive()
          && (mgr() || swapOffer() || swapCancel() || swapClaim() || swapWithdraw() || claimOpen());
      }

      // Staff availability — employees mark dates they can't work so managers can
      // roster around them. Self-authored; managers see everyone's. Immutable
      // once set (remove and re-add to change), and either the owner or a manager
      // may remove one.
      match /availability/{availId} {
        allow read: if mgr()
          || (member() && resource.data.userId == request.auth.token.userId);

        allow create: if member() && liveActive()
          && request.resource.data.userId == request.auth.token.userId
          && request.resource.data.userName == request.auth.token.name
          && request.resource.data.date is string;

        allow update: if false;
        allow delete: if liveActive() && (mgr()
          || (member() && resource.data.userId == request.auth.token.userId));
      }

      // Week templates — saved roster patterns, a manager-only planning tool.
      // Not employee-facing (they're applied to produce real schedule shifts).
      match /templates/{templateId} {
        allow read: if mgr();
        allow write: if mgr() && liveActive();
      }

      // Schedule publish records — one per week, written only by the publish
      // route (Admin SDK, which bypasses rules). Managers read to show state.
      match /schedulePublished/{weekId} {
        allow read: if mgr();
        allow write: if false;
      }

      // Shift notes — the digital counter notebook. Visibility mirrors entries;
      // text is immutable; managers may pin/archive.
      match /notes/{noteId} {
        allow read: if member() && (
          mgr() || sharedAcrossLocations()
          || (request.auth.token.locationId != null
              && resource.data.locationId == request.auth.token.locationId));
        allow create: if member() && liveActive()
          && request.resource.data.byId == request.auth.token.userId
          && request.resource.data.by == request.auth.token.name
          && request.resource.data.text.size() <= 2000
          && (mgr() || request.resource.data.locationId == request.auth.token.locationId)
          && request.resource.data.pinned == false
          && request.resource.data.active == true;
        allow update: if mgr() && liveActive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'active']);
        allow delete: if false;
      }
    }
  }
}
