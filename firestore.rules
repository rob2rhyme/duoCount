rules_version = '2';

// ---------------------------------------------------------------------------
// Firestore security rules
//
//   phoneAuth  – holds the store phone number the login screen sends the OTP
//                to. Readable by anyone (needed BEFORE sign-in); never writable
//                from the client. Manage it from the Firebase console.
//   users      – one document per user (id = auth uid) holding their { role }.
//                A user may read their OWN document; roles are assigned from
//                the Firebase console or a trusted admin script, never from the
//                client.
//   products   – inventory items. Read for any signed-in user; writes for
//                editor roles (admin/staff).
//   categories – product groupings. Same access as products.
//
// See documentation/index.html → "Roles & permissions" and "Security rules".
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    // The signed-in user's role, or "viewer" if they have no users/{uid} doc.
    function userRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'viewer';
    }
    function canEdit() {
      return isSignedIn() && userRole() in ['admin', 'staff'];
    }
    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    // --- collections -------------------------------------------------------
    match /phoneAuth/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      // Users can read their own role; only admins can read the whole roster.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Admins create user records with a valid role and only the known fields.
      allow create: if isAdmin()
        && request.resource.data.role in ['admin', 'staff', 'viewer']
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'phone']);
      // On update, only role/displayName/phone may change (diff() tolerates any
      // extra pre-existing fields written by the console/admin scripts), and an
      // admin may not lower their OWN role — preventing self-lockout.
      allow update: if isAdmin()
        && request.resource.data.role in ['admin', 'staff', 'viewer']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'displayName', 'phone'])
        && (request.auth.uid != userId || request.resource.data.role == 'admin');
      // An admin cannot delete their own record (prevents self-lockout).
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if canEdit(); // admin + staff
      allow delete: if isAdmin(); // admin only
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if canEdit(); // admin + staff
      allow delete: if isAdmin(); // admin only
    }

    // Append-only activity log: a signed-in user may record actions ONLY under
    // their own uid (so entries can't be forged onto someone else), with a
    // known action and shape. Only admins can read; entries are immutable.
    match /activityLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['add', 'edit', 'delete', 'import']
        && request.resource.data.keys().hasOnly(
             ['action', 'item', 'category', 'detail', 'actorUid', 'actorRole', 'at']
           );
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
